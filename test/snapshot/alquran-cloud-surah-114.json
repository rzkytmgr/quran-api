          "number": 6235,
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "yang membisikkan (kejahatan) ke dalam dada manusia,"
        },
        {
          "number": 6236,
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "dari (golongan) jin dan manusia."
