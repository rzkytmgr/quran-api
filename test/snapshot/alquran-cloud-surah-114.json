          "hizbQuarter": 240,
          "sajda": false,
          "text": "Say, \"I seek refuge in the Lord of mankind,"
        },
        {
          "number": 6232,
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "The Sovereign of mankind."
        },
        {
          "number": 6233,
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "The God of mankind,"
        },
        {
          "number": 6234,
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "From the evil of the retreating whisperer -"
        },
        {
          "number": 6235,
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "Who whispers [evil] into the breasts of mankind -"
        },
        {
          "number": 6236,
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "From among the jinn and mankind.\""
        }
      ]
    },
    {
      "ayahs": [
        {
          "number": 6231,
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "Katakanlah: \"Aku berlindung kepada Tuhan (yang memelihara dan menguasai) manusia."
        },
        {
          "number": 6232,
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "Raja manusia."
        },
        {
          "number": 6233,
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "Sembahan manusia."
        },
        {
          "number": 6234,
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 604,
          "ruku": 556,
          "hizbQuarter": 240,
          "sajda": false,
          "text": "Dari kejahatan (bisikan) syaitan yang biasa bersembunyi,"
