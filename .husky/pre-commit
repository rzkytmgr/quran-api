#!/bin/sh
set -e

echo "start pre-commit commands!"

pnpm dev:format

git diff --cached --name-only | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  else
    git rm --cached --ignore-unmatch -- "$file" >/dev/null 2>&1 || true
  fi
done

pnpm dev:test
pnpm dev:lint
pnpm build
echo "You're allowed sir!"
