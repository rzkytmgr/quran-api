{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "dynamicImport": true
    },
    "target": "es2020",
    "loose": false,
    "transform": {
      "legacyDecorator": false,
      "decoratorMetadata": false
    },
    "keepClassNames": true,
    "baseUrl": "./",
    "paths": {
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@dataset/*": ["src/dataset/*"],
      "@modules/*": ["src/modules/*"],
      "@shared/*": ["src/shared/*"]
    },
    "externalHelpers": false,
    "preserveAllComments": false
  },
  "module": {
    "resolveFully": true,
    "outFileExtension": "js",
    "type": "es6",
    "strict": true,
    "ignoreDynamic": false
  },
  "sourceMaps": false,
  "minify": true,
  "exclude": ["node_modules", "dist", ".husky", ".github", "static", "test"],
  "test": ["src"]
}
