{
  "name": "@rzkytmgr/quran-api",
  "version": "0.1.0",
  "description": "A free and open-source multilingual Qur'an REST API providing surahs, ayahs, audio, and support for custom reciters. Easy to integrate into your frontend or any project that needs reliable Qur'an data.",
  "main": "./dist/server.js",
  "scripts": {
    "dev:format": "prettier --write .",
    "dev:format:check": "prettier --check .",
    "dev:format:watch": "prettier --watch .",
    "dev:lint": "eslint .",
    "dev:watch": "tsx watch src/server.ts",
    "dev:watch:crawler": "tsx watch bin/scraper.mjs",
    "dev:typecheck": "pnpm build:typecheck",
    "dev:test": "vitest run --config vitest.config.mjs",
    "dev:vercel": "vercel dev --listen 5000 -d -A vercel.json",
    "crawl": "node bin/scraper.mjs",
    "build": "pnpm build:typecheck && pnpm build:swc",
    "build:typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.crawler.json",
    "build:typecheck:server": "tsc --noEmit --project tsconfig.json",
    "build:typecheck:crawler": "tsc --noEmit --project tsconfig.crawler.json",
    "build:swc": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && swc src -d dist --strip-leading-paths",
    "start": "node --env-file=.env.example .",
    "prepare": "husky"
  },
  "keywords": [
    "quran",
    "quran-api",
    "islamic",
    "muslim-app"
  ],
  "author": {
    "name": "Rizky Aulia Tumangger",
    "url": "https://github.com/rzkytmgr"
  },
  "homepage": "https://staticquran.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzkytmgr/quran-api.git"
  },
  "bugs": {
    "url": "https://github.com/rzkytmgr/quran-api/issues"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "vite": "7.3.7",
      "esbuild": "0.28.1"
    }
  },
  "type": "module",
  "dependencies": {
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "ramda": "^0.32.0",
    "winston": "^3.19.0",
    "yocto-spinner": "^0.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/ramda": "^0.31.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "resolve-tspaths": "^0.8.23",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  }
}
