{
  "compilerOptions": {
    "target": "es2020",
    "module": "es6",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@dataset/*": ["src/dataset/*"],
      "@modules/*": ["src/modules/*"],
      "@shared/*": ["src/shared/*"]
    },
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "inlineSourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "newLine": "crlf",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "data", "test"]
}
